{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // the generated package import rules (bun run build:import-rules)
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json", "./.oxlintrc.imports.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    // every file that tripped this needed an exemption rather than a change,
    // so the count was never the thing worth holding down
    "import/max-dependencies": "off",
    // atc's comments predate these two rules of the shared config; GEO-463
    // adopts them
    "zgeoff/no-jsdoc": "off",
    "zgeoff/max-consecutive-line-comments": "off",
    "zgeoff/function-verb": [
      "error",
      {
        "verbs": [
          "ack",
          "acquire",
          "adopt",
          "advance",
          "answer",
          "attach",
          "boot",
          "copy",
          "destroy",
          "detach",
          "dispose",
          "draw",
          "forget",
          "jiggle",
          "kill",
          "log",
          "materialize",
          "mint",
          "open",
          "quit",
          "reconcile",
          "record",
          "refresh",
          "release",
          "renew",
          "restart",
          "restore",
          "revoke",
          "sanitize",
          "schedule",
          "spawn",
          "suspend",
          "transfer",
          "truncate",
          "yank"
        ],
        "exemptNames": [
          "cols",
          "rows",
          "ptyRows",
          "out",
          "main",
          "boxTop",
          "boxDivider",
          "boxBottom",
          "boxRow",
          "dimRow",
          // kysely's Driver interface: BunSqliteDriver implements it, so
          // these method names are fixed by the library contract
          "init",
          "acquireConnection",
          "beginTransaction",
          "commitTransaction",
          "rollbackTransaction",
          "releaseConnection"
        ]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "allow": [
          { "from": "lib", "name": "Buffer" },
          { "from": "package", "name": "Buffer", "package": "@types/node" },
          // a live PTY process handle: connection and event state, no readonly form
          { "from": "package", "name": "IPty", "package": "bun-pty" },
          // mutable by design: sessions are live state, views borrow them
          { "from": "file", "name": "Session" },
          { "from": "file", "name": "SessionManager" },
          // the daemon's per-session bookkeeping: screen, timers, and
          // headless-run handle, mutated in place by the daemon
          { "from": "file", "name": "SessionRuntime" },
          // the stub imp port's own records of each imp, process, and
          // connection, mutated in place as the stub runs them
          { "from": "file", "name": "StubImp" },
          { "from": "file", "name": "StubProcess" },
          { "from": "file", "name": "StubConnection" },
          // the imp provider's record of one imp, and a live connection to
          // an imp session, both changed in place as the imp runs
          { "from": "file", "name": "ImpHost" },
          { "from": "file", "name": "ImpSessionConnection" },
          // a configured execution target: it holds its live provider
          { "from": "file", "name": "ExecutionTarget" },
          // a principal's grants, held privately and never mutated
          { "from": "file", "name": "TargetAccess" },
          // wraps a live db connection; not meaningfully freezable
          { "from": "file", "name": "StateStore" },
          // the runtime auth binder: its per-host call queue changes as
          // calls arrive and finish
          { "from": "file", "name": "RuntimeAuthBinder" },
          // a plugin's definition: its zod config schema has no readonly form
          { "from": "file", "name": "PluginDefinition" },
          // wraps a live db connection; not meaningfully freezable
          { "from": "package", "name": "Database", "package": "bun:sqlite" },
          // a query builder bound to a live connection; not meaningfully
          // freezable
          { "from": "package", "name": "Kysely", "package": "kysely" },
          // every field is already readonly; the type itself has no
          // readonly form to wrap it in
          { "from": "package", "name": "CompiledQuery", "package": "kysely" },
          { "from": "file", "name": "Config" },
          { "from": "file", "name": "HookEvent" },
          { "from": "file", "name": "OverlayView" },
          { "from": "file", "name": "PickerView" },
          { "from": "file", "name": "TestContext" },
          // branded primitives: the tag is a readonly symbol key carrying no
          // mutable state, so there is nothing for a readonly wrapper to add
          { "from": "file", "name": "SessionID" },
          { "from": "file", "name": "AgentSessionID" },
          { "from": "file", "name": "MessageID" },
          { "from": "file", "name": "DaemonID" },
          // already the readonly form; the rule doesn't recognize it as such
          { "from": "lib", "name": "ReadonlySet" },
          { "from": "lib", "name": "ReadonlyMap" },
          // a kysely connection bound to a live driver; not meaningfully freezable
          { "from": "package", "name": "DatabaseConnection", "package": "kysely" },
          // a migrator result read once for its error field, never mutated
          { "from": "package", "name": "MigrationResultSet", "package": "kysely" },
          // a live HTTP request: its body is a one-shot stream, so it has no
          // readonly form
          { "from": "package", "name": "Request", "package": "bun-types" },
          // read only by the routes; its setters are the only mutable part
          { "from": "package", "name": "URL", "package": "bun-types" },
          // wraps a live better-auth instance and its database connection;
          // not meaningfully freezable
          { "from": "file", "name": "HTTPServerContext" },
          // bytes read from or written to a socket, a PTY, a file, or an
          // archive: like Buffer, a byte array has no readonly form
          { "from": "lib", "name": "Uint8Array" },
          // a promise has no state a caller can change; it only settles
          { "from": "lib", "name": "Promise" },
          // a date as the imp client returns it; the rule finds no readonly
          // form of its setters
          { "from": "lib", "name": "Date" },
          // a live socket or daemon connection: the holder writes to it and
          // releases it, so it has no readonly form
          { "from": "package", "name": "Socket", "package": "bun-types" },
          { "from": "file", "name": "DaemonConnection" },
          // the daemon's tap registry: a delivery claims a message or a
          // notice in it in place
          { "from": "file", "name": "TapRegistry" },
          // kysely builders bound to a live connection or query; not
          // meaningfully freezable
          { "from": "package", "name": "Transaction", "package": "kysely" },
          { "from": "package", "name": "ExpressionBuilder", "package": "kysely" },
          // the dependencies each daemon session module takes: the modules
          // they hold keep mutable session state
          { "from": "file", "name": "AuthSetupDeps" },
          { "from": "file", "name": "HostDirClaimsDeps" },
          { "from": "file", "name": "SessionAdopterDeps" },
          { "from": "file", "name": "SessionFleetWriterDeps" },
          { "from": "file", "name": "SessionHarnessesDeps" },
          { "from": "file", "name": "SessionKillerDeps" },
          { "from": "file", "name": "SessionRestorerDeps" },
          { "from": "file", "name": "SessionSpawnerDeps" },
          { "from": "file", "name": "SpawnRollbackDeps" }
        ]
      }
    ],
    // Bun's synchronous spawn can lose a child's exit and spin its caller
    // forever (oven-sh/bun#34069); an async spawn keeps the caller's event
    // loop and its timeouts alive. The property rule catches access and
    // destructuring on `Bun` itself, not on an alias of it. Production code
    // reads the time through a clock it is given, so a test can step it.
    "no-restricted-properties": [
      "error",
      {
        "object": "Bun",
        "property": "spawnSync",
        "message": "Use an async spawn: Bun.spawnSync can lose a child's exit and hang (oven-sh/bun#34069)."
      },
      {
        "object": "Date",
        "property": "now",
        "message": "Read the time through an injected Clock (@atc/core/system-clock)."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:child_process",
            "importNames": ["spawnSync", "execSync", "execFileSync"],
            "message": "Use an async spawn: Bun runs these through its synchronous spawn, which can lose a child's exit and hang (oven-sh/bun#34069)."
          },
          {
            "name": "child_process",
            "importNames": ["spawnSync", "execSync", "execFileSync"],
            "message": "Use an async spawn: Bun runs these through its synchronous spawn, which can lose a child's exit and hang (oven-sh/bun#34069)."
          }
        ]
      }
    ],
    "max-statements": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-params": "off",
    "no-inline-comments": "off",
    "no-continue": "off",
    "init-declarations": "off",
    "no-await-in-loop": "off",
    "promise/avoid-new": "off",
    "require-unicode-regexp": "off"
  },
  "overrides": [
    {
      // the system clock itself, tests, test helpers (a package's testing
      // folder among them), and tooling read the
      // wall clock directly; an override replaces the rule's options, so it
      // repeats the spawn entry
      "files": [
        "packages/core/src/system-clock.ts",
        "**/*.test.ts",
        "packages/test-utils/**",
        "packages/app/src/test-utils/**",
        "packages/*/src/testing/**",
        "packages/*/*/src/testing/**",
        "e2e/**",
        "scripts/**"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Bun",
            "property": "spawnSync",
            "message": "Use an async spawn: Bun.spawnSync can lose a child's exit and hang (oven-sh/bun#34069)."
          }
        ]
      }
    },
    {
      // the daemon.ts topic tests: the daemon split (GEO-401) moved each
      // topic of daemon.ts into a test of its own, so no module shares its
      // name; listed by file, so a new orphan test still fails the rule
      "files": [
        "packages/app/src/daemon/daemon-agent-kinds.test.ts",
        "packages/app/src/daemon/daemon-agent-registry.test.ts",
        "packages/app/src/daemon/daemon-agents.test.ts",
        "packages/app/src/daemon/daemon-answer-notices.test.ts",
        "packages/app/src/daemon/daemon-auth-gateway.test.ts",
        "packages/app/src/daemon/daemon-codex-guest-auth.test.ts",
        "packages/app/src/daemon/daemon-config-file.test.ts",
        "packages/app/src/daemon/daemon-connection-reach.test.ts",
        "packages/app/src/daemon/daemon-detector.test.ts",
        "packages/app/src/daemon/daemon-event-sweep.test.ts",
        "packages/app/src/daemon/daemon-events.test.ts",
        "packages/app/src/daemon/daemon-fleet-restart.test.ts",
        "packages/app/src/daemon/daemon-fleet.test.ts",
        "packages/app/src/daemon/daemon-forget.test.ts",
        "packages/app/src/daemon/daemon-gateway-guest-auth.test.ts",
        "packages/app/src/daemon/daemon-gateway-workspace-trust.test.ts",
        "packages/app/src/daemon/daemon-headless.test.ts",
        "packages/app/src/daemon/daemon-hook-agent.test.ts",
        "packages/app/src/daemon/daemon-idempotency.test.ts",
        "packages/app/src/daemon/daemon-imp-bridge.test.ts",
        "packages/app/src/daemon/daemon-imp-guest.test.ts",
        "packages/app/src/daemon/daemon-imp-placement.test.ts",
        "packages/app/src/daemon/daemon-imp-project-settings.test.ts",
        "packages/app/src/daemon/daemon-imp-workspace.test.ts",
        "packages/app/src/daemon/daemon-imp.test.ts",
        "packages/app/src/daemon/daemon-last-used.test.ts",
        "packages/app/src/daemon/daemon-local-workspace-trust.test.ts",
        "packages/app/src/daemon/daemon-messages.test.ts",
        "packages/app/src/daemon/daemon-permission-pending.test.ts",
        "packages/app/src/daemon/daemon-principals.test.ts",
        "packages/app/src/daemon/daemon-provider.test.ts",
        "packages/app/src/daemon/daemon-resume-command.test.ts",
        "packages/app/src/daemon/daemon-runtime-auth.test.ts",
        "packages/app/src/daemon/daemon-session-record.test.ts",
        "packages/app/src/daemon/daemon-sources.test.ts",
        "packages/app/src/daemon/daemon-targets.test.ts",
        "packages/app/src/daemon/daemon-tcp.test.ts",
        "packages/app/src/daemon/daemon-workspace.test.ts"
      ],
      "rules": {
        "zgeoff/test-beside-module": "off"
      }
    }
  ],
  "ignorePatterns": [".claude/**", "mods/**"]
}

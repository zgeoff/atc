{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json", "./.oxlintrc.zones.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "zgeoff/function-verb": [
      "error",
      {
        "verbs": [
          "ack",
          "acquire",
          "adopt",
          "answer",
          "attach",
          "boot",
          "copy",
          "destroy",
          "detach",
          "dispose",
          "draw",
          "forget",
          "jiggle",
          "kill",
          "log",
          "materialize",
          "mint",
          "quit",
          "reconcile",
          "renew",
          "sanitize",
          "suspend",
          "transfer",
          "truncate",
          "yank"
        ],
        "exemptNames": [
          "cols",
          "rows",
          "ptyRows",
          "out",
          "main",
          "boxTop",
          "boxDivider",
          "boxBottom",
          "boxRow",
          "dimRow",
          // kysely's Driver interface: BunSqliteDriver implements it, so
          // these method names are fixed by the library contract
          "init",
          "acquireConnection",
          "beginTransaction",
          "commitTransaction",
          "rollbackTransaction",
          "releaseConnection"
        ]
      }
    ],
    // Bun's synchronous spawn can lose a child's exit and spin its caller
    // forever (oven-sh/bun#34069); an async spawn keeps the caller's event
    // loop and its timeouts alive. The property rule catches access and
    // destructuring on `Bun` itself, not on an alias of it. Production code
    // reads the time through a clock it is given, so a test can step it.
    "no-restricted-properties": [
      "error",
      {
        "object": "Bun",
        "property": "spawnSync",
        "message": "Use an async spawn: Bun.spawnSync can lose a child's exit and hang (oven-sh/bun#34069)."
      },
      {
        "object": "Date",
        "property": "now",
        "message": "Read the time through an injected Clock (@atc/core/system-clock)."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:child_process",
            "importNames": ["spawnSync", "execSync", "execFileSync"],
            "message": "Use an async spawn: Bun runs these through its synchronous spawn, which can lose a child's exit and hang (oven-sh/bun#34069)."
          },
          {
            "name": "child_process",
            "importNames": ["spawnSync", "execSync", "execFileSync"],
            "message": "Use an async spawn: Bun runs these through its synchronous spawn, which can lose a child's exit and hang (oven-sh/bun#34069)."
          }
        ]
      }
    ],
    // atc is ES modules throughout, so a module loads through an import
    "typescript/no-require-imports": "error",
    // GEO-1196 splits the 19 files over the shared 500-line limit
    "max-lines": "off",
    // GEO-1197 trims the 60 functions over the shared four-parameter limit
    "max-params": "off",
    // the source holds short and abbreviated value names, such as i and dir
    "id-length": "off",
    "zgeoff/no-abbreviated-names": "off",
    // the source branches on unions with switch statements
    "zgeoff/no-switch": "off"
  },
  "overrides": [
    {
      // the system clock itself, tests, test helpers (a package's testing
      // folder among them), and tooling read the
      // wall clock directly; an override replaces the rule's options, so it
      // repeats the spawn entry
      "files": [
        "packages/core/src/system-clock.ts",
        "**/*.test.ts",
        "packages/test-utils/**",
        "packages/app/src/test-utils/**",
        "packages/*/src/testing/**",
        "packages/*/*/src/testing/**",
        "e2e/**",
        "scripts/**"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Bun",
            "property": "spawnSync",
            "message": "Use an async spawn: Bun.spawnSync can lose a child's exit and hang (oven-sh/bun#34069)."
          }
        ]
      }
    },
    {
      // the generic packages name no execution provider in their text
      "files": ["packages/**"],
      "rules": {
        "zgeoff/no-restricted-words": ["error", { "words": ["imp", "impd", "impz"] }]
      }
    },
    {
      // the imp execution plugin, the shared test helpers, and the composition
      // root that ships the plugin may name imp
      "files": [
        "packages/execution/**",
        "packages/test-utils/**",
        "packages/app/src/plugins/shipped-execution-plugins.ts"
      ],
      "rules": { "zgeoff/no-restricted-words": "off" }
    },
    {

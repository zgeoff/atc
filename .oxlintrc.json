{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "zgeoff/function-verb": [
      "error",
      {
        "verbs": [
          "ack",
          "adopt",
          "answer",
          "attach",
          "boot",
          "copy",
          "detach",
          "draw",
          "jiggle",
          "kill",
          "log",
          "open",
          "quit",
          "record",
          "refresh",
          "restart",
          "restore",
          "schedule",
          "spawn",
          "truncate",
          "yank"
        ],
        "exemptNames": [
          "cols",
          "rows",
          "ptyRows",
          "out",
          "main",
          "boxTop",
          "boxDivider",
          "boxBottom",
          "boxRow",
          "dimRow"
        ]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "allow": [
          { "from": "lib", "name": "Buffer" },
          { "from": "package", "name": "Buffer", "package": "@types/node" },
          // a live PTY process handle: connection and event state, no readonly form
          { "from": "package", "name": "IPty", "package": "bun-pty" },
          // mutable by design: sessions are live state, views borrow them
          { "from": "file", "name": "Session" },
          { "from": "file", "name": "SessionManager" },
          { "from": "file", "name": "Config" },
          { "from": "file", "name": "HookEvent" },
          { "from": "file", "name": "OverlayView" },
          { "from": "file", "name": "PickerView" },
          { "from": "file", "name": "TestContext" },
          // branded primitives: the tag is a readonly symbol key carrying no
          // mutable state, so there is nothing for a readonly wrapper to add
          { "from": "file", "name": "SessionID" },
          { "from": "file", "name": "AgentSessionID" }
        ]
      }
    ],
    "max-statements": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-params": "off",
    "no-inline-comments": "off",
    "no-continue": "off",
    "init-declarations": "off",
    "no-await-in-loop": "off",
    "promise/avoid-new": "off",
    "require-unicode-regexp": "off"
  },
  "overrides": [
    {
      "files": ["src/index.ts"],
      // the TUI client entry holds the screens, the key routing and the
      // fleet mirror together, and every import it keeps is read by two or
      // more of them
      "rules": {
        "import/max-dependencies": ["error", { "max": 12 }]
      }
    },
    {
      "files": ["src/daemon.ts"],
      // the daemon entry wires the two listeners to the session manager, the
      // screen models, the attach and permission registries and the store,
      // and each import belongs to one of those connections; the branded
      // session and agent-session id types add one import each
      "rules": {
        "import/max-dependencies": ["error", { "max": 13 }]
      }
    },
    {
      "files": ["src/grok-adapter.ts"],
      // the adapter's own dependencies plus the branded session and
      // agent-session id types it keys and mints at its hook boundary, plus
      // zod for its hook payload schema
      "rules": {
        "import/max-dependencies": ["error", { "max": 13 }]
      }
    },
    {
      "files": ["src/codex-adapter.ts"],
      // the adapter's own dependencies plus zod for its hook payload schema
      "rules": {
        "import/max-dependencies": ["error", { "max": 11 }]
      }
    },
    {
      "files": ["src/daemon-last-used.test.ts"],
      // drives a whole daemon plus a grok adapter and the branded
      // agent-session id its fixture fleet entry needs
      "rules": {
        "import/max-dependencies": ["error", { "max": 11 }]
      }
    },
    {
      "files": ["src/daemon-headless.test.ts", "test/daemon-e2e.test.ts"],
      // these drive a whole daemon end to end: its options, the adapters they
      // register, a client to talk to it, the helpers their assertions
      // narrow wire payloads with, and the branded agent-session id their
      // fixture fleet entries need
      "rules": {
        "import/max-dependencies": ["error", { "max": 12 }]
      }
    }
  ],
  "ignorePatterns": [".claude/**"]
}

{
  "name": "@zgeoff/atc",
  "version": "4.7.0",
  "private": true,
  "description": "Terminal control tower for coding-agent sessions",
  "homepage": "https://github.com/zgeoff/atc#readme",
  "bugs": "https://github.com/zgeoff/atc/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/atc.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/harnesses/*",
      "packages/execution/*",
      "packages/sources/*"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.222",
      "@better-auth/mcp": "1.7.6",
      "@better-auth/oauth-provider": "1.7.6",
      "@commitlint/cli": "21.2.0",
      "@faker-js/faker": "10.6.0",
      "@modelcontextprotocol/sdk": "1.31.0",
      "@orpc/contract": "1.15.4",
      "@stylistic/eslint-plugin": "5.10.0",
      "@tsconfig/strictest": "2.0.8",
      "@types/bun": "1.4.2",
      "@types/proper-lockfile": "4.1.4",
      "@xterm/addon-serialize": "0.14.0",
      "@xterm/headless": "6.0.0",
      "@zgeoff/bun-test-extended": "0.0.4",
      "@zgeoff/format-codemod": "0.1.0",
      "@zgeoff/imp-client": "1.4.0",
      "@zgeoff/oxlint-config": "0.2.0",
      "better-auth": "1.7.6",
      "bun-pty": "0.4.10",
      "citty": "0.2.2",
      "knip": "6.24.0",
      "kysely": "0.29.5",
      "lefthook": "2.1.10",
      "lru-cache": "11.5.3",
      "oxfmt": "0.57.0",
      "oxlint": "1.73.0",
      "oxlint-tsgolint": "0.24.0",
      "proper-lockfile": "4.1.2",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.0",
      "tslib": "2.8.1",
      "type-fest": "5.8.0",
      "typescript": "7.0.2",
      "xstate": "5.32.5",
      "zod": "4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "start": "bun packages/app/src/cli.ts",
    "build:atc-bridge": "bun scripts/build-atc-bridge.ts && oxfmt packages/harnesses/claude/src/bridge/atc-bridge-files.ts && format-codemod --quiet packages/harnesses/claude/src/bridge/atc-bridge-files.ts",
    "build:binaries": "bash scripts/build-binaries.sh",
    "build:import-rules": "bun scripts/build-import-rules.ts && oxfmt .oxlintrc.imports.json",
    "audit": "bun audit",
    "check:imports": "bun scripts/check-imports.ts",
    "check:disable-baseline": "bun scripts/check-disable-baseline.ts",
    "check:manifests": "bun scripts/check-manifests.ts",
    "check:reach": "bun scripts/check-reach.ts",
    "deadcode": "knip",
    "demo:record": "bash scripts/record-demo.sh",
    "files:branch": "bun scripts/collect-branch-files.ts",
    "lint": "oxlint",
    "lint:files": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:shell": "git ls-files -z '*.sh' ':!.claude/**' | xargs -0 sh -c 'shellcheck \"$@\" && shfmt -d \"$@\"' sh",
    "lint:full": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "test": "bash scripts/with-test-home.sh bun test --parallel --timings=bun-test-timings.json",
    "test:related": "bun scripts/run-related-tests.ts",
    "test:timings": "bash scripts/with-test-home.sh bun test --parallel --timings=bun-test-timings.json --update-timings",
    "test:binary": "bash scripts/with-test-home.sh bun test --timeout 20000 e2e/daemon-*.test.ts",
    "test:gateway-binary": "bash scripts/with-test-home.sh bun test --timeout 20000 e2e/gateway-*.test.ts",
    "test:atc-bridge": "bash scripts/with-test-home.sh sh -c 'claude plugin validate --strict mods/atc-bridge && claude plugin test mods/atc-bridge'",
    "test:isolation": "bun scripts/check-test-isolation.ts",
    "test:plugin": "bun scripts/test-plugin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true"
  },
  "devDependencies": {
    "@atc/config": "workspace:*",
    "@atc/core": "workspace:*",
    "@atc/lifecycle": "workspace:*",
    "@atc/protocol": "workspace:*",
    "@atc/store": "workspace:*",
    "@atc/test-utils": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/bun-test-extended": "catalog:",
    "@zgeoff/format-codemod": "catalog:",
    "@zgeoff/oxlint-config": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tiny-invariant": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": ">=4.13.5",
    "ip-address": "10.7.2",
    "js-yaml": ">=4.3.2 <5",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "smol-toml": "1.9.0",
    "tinypool": "2.1.2"
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "knip@6.24.0": "patches/knip@6.24.0.patch"
  }
}

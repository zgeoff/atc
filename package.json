{
  "name": "@zgeoff/atc",
  "version": "2.26.7",
  "description": "Terminal control tower for coding-agent sessions",
  "homepage": "https://github.com/zgeoff/atc#readme",
  "bugs": "https://github.com/zgeoff/atc/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/atc.git"
  },
  "bin": {
    "atc": "bin/atc"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "build:agents": "bash scripts/build-agents-md.sh agents/shared.md agents/project.md AGENTS.md",
    "build:atc-bridge": "bun scripts/build-atc-bridge.ts && oxfmt src/agents/atc-bridge-files.ts && format-codemod --quiet src/agents/atc-bridge-files.ts",
    "build:binaries": "bash scripts/build-binaries.sh",
    "audit": "bun audit",
    "check:imports": "bun scripts/check-imports.ts",
    "deadcode": "knip",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error --fix",
    "test": "bash scripts/with-test-home.sh bun test",
    "test:binary": "bash scripts/with-test-home.sh bun test --timeout 20000 test/daemon-e2e.test.ts",
    "test:gateway-binary": "bash scripts/with-test-home.sh bun test --timeout 20000 src/gateway.test.ts",
    "test:atc-bridge": "bash scripts/with-test-home.sh bash scripts/test-atc-bridge.sh",
    "test:isolation": "bash scripts/check-test-isolation.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.222",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@zgeoff/imp-client": "0.27.0",
    "better-auth": "1.7.6",
    "bun-pty": "0.4.10",
    "citty": "0.2.2",
    "kysely": "0.29.5",
    "ts-pattern": "5.9.0",
    "xstate": "5.32.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "@zgeoff/bun-test-extended": "0.0.4",
    "@zgeoff/format-codemod": "0.0.8",
    "@zgeoff/oxlint-config": "0.0.6",
    "knip": "6.24.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.57.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "tslib": "2.8.1",
    "type-fest": "5.8.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": ">=4.13.5",
    "ip-address": "10.7.2",
    "js-yaml": ">=4.3.2 <5",
    "qs": "6.16.0"
  },
  "packageManager": "bun@1.3.10"
}

{
  "name": "@zgeoff/atc",
  "version": "7.7.0",
  "private": true,
  "description": "Terminal control tower for coding-agent sessions",
  "homepage": "https://github.com/zgeoff/atc#readme",
  "bugs": "https://github.com/zgeoff/atc/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/atc.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/harnesses/*",
      "packages/execution/*",
      "packages/sources/*"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.296",
      "@better-auth/mcp": "1.7.7",
      "@better-auth/oauth-provider": "1.7.7",
      "@commitlint/cli": "21.2.3",
      "@faker-js/faker": "10.6.0",
      "@impz/client": "4.2.5",
      "@logtape/logtape": "2.4.1",
      "@maschwenk/tsrslint": "0.1.6",
      "@modelcontextprotocol/sdk": "1.32.1",
      "@modelcontextprotocol/server": "2.3.0",
      "@orpc/client": "1.16.0",
      "@orpc/contract": "1.16.0",
      "@orpc/server": "1.16.0",
      "@orpc/standard-server": "1.16.0",
      "@orpc/standard-server-peer": "1.16.0",
      "@simplewebauthn/server": "14.0.3",
      "reflect-metadata": "0.2.2",
      "@stylistic/eslint-plugin": "5.10.0",
      "@tsconfig/strictest": "2.0.8",
      "@types/bun": "1.4.2",
      "@types/proper-lockfile": "4.1.4",
      "@xterm/addon-serialize": "0.14.0",
      "@xterm/headless": "6.0.0",
      "@zgeoff/bun-test-extended": "0.2.2",
      "@zgeoff/format-codemod": "0.3.4",
      "@zgeoff/kysely-bun-sqlite": "0.3.0",
      "@zgeoff/oxlint-config": "0.7.3",
      "@zgeoff/skill-gate": "0.2.9",
      "@zgeoff/std": "0.3.0",
      "better-auth": "1.7.7",
      "bun-pty": "0.5.1",
      "elysia": "1.4.30",
      "gunshi": "1.0.0-rc.1",
      "knip": "6.41.0",
      "kysely": "0.29.6",
      "lefthook": "2.2.1",
      "lru-cache": "11.5.3",
      "oxfmt": "0.72.0",
      "oxlint": "1.87.0",
      "proper-lockfile": "4.1.2",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.0",
      "tslib": "2.8.1",
      "type-fest": "5.10.0",
      "tsrs": "0.18.0-ts7.1.0-dev.20260929",
      "typescript": "7.0.2",
      "xstate": "5.33.2",
      "zod": "4.6.6"
    }
  },
  "type": "module",
  "scripts": {
    "start": "bun packages/app/src/cli.ts",
    "build:atc-bridge": "bun scripts/build-atc-bridge.ts && oxfmt packages/harnesses/claude/src/bridge/atc-bridge-files.ts && format-codemod --quiet packages/harnesses/claude/src/bridge/atc-bridge-files.ts",
    "build:binaries": "bash scripts/build-binaries.sh",
    "audit": "bun audit --ignore=GHSA-g3hv-75wg-m249",
    "check:bundle": "bun scripts/check-bundle.ts",
    "check:contract": "bun scripts/check-contract.ts",
    "check:imports": "bun scripts/check-imports.ts",
    "check:disable-baseline": "bun scripts/check-disable-baseline.ts",
    "check:guest-scripts": "bun scripts/check-guest-scripts.ts",
    "check:manifests": "bun scripts/check-manifests.ts",
    "check:raw-escapes": "bun scripts/check-raw-escapes.ts",
    "check:reach": "bun scripts/check-reach.ts",
    "check:source-entries": "bun scripts/check-source-entries.ts",
    "ci:pick-release-ship": "bun scripts/pick-release-ship.ts",
    "deadcode": "bun scripts/deadcode.ts",
    "demo:record": "bash scripts/record-demo.sh",
    "files:branch": "bun scripts/read-branch-files.ts",
    "lint": "oxlint",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "lint:shell": "git ls-files -z '*.sh' ':!.claude/**' | xargs -0 sh -c 'shellcheck \"$@\" && shfmt -d \"$@\"' sh",
    "lint:full": "tsgolint=$(tsrslint-path) && OXLINT_TSGOLINT_PATH=$tsgolint oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:mods": "oxlint -c .oxlintrc.mods.json mods",
    "test": "workers=$(bun scripts/read-worker-count.ts) && bash scripts/with-test-home.sh bun test --parallel=$workers --no-isolate --timings=bun-test-timings.json",
    "test:related": "bun scripts/run-related-tests.ts",
    "test:timings": "workers=$(bun scripts/read-worker-count.ts) && bash scripts/with-test-home.sh bun test --parallel=$workers --no-isolate --timings=bun-test-timings.json --update-timings",
    "test:e2e": "workers=$(bun scripts/read-worker-count.ts) && bash scripts/with-test-home.sh bash scripts/with-e2e-paths.sh bun test --parallel=$workers --no-isolate --timeout 15000 --path-ignore-patterns='mods/**' --",
    "test:codex": "workers=$(bun scripts/read-worker-count.ts) && bash scripts/with-test-home.sh bun test --parallel=$workers --no-isolate --path-ignore-patterns='mods/**' .codex.test",
    "test:atc-bridge": "bash scripts/with-test-home.sh sh -c 'claude plugin validate --strict mods/atc-bridge && claude plugin test mods/atc-bridge'",
    "test:isolation": "bun scripts/check-test-isolation.ts",
    "test:plugin": "bun scripts/test-plugin.ts",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true",
    "check:commits": "bun scripts/run-commits-check.ts",
    "check:local-paths": "bun scripts/run-local-paths-check.ts",
    "check:test-timeouts": "bun scripts/run-test-timeouts-check.ts",
    "check:dependency-gates": "bun scripts/dependency-gates/run-dependency-gates-check.ts",
    "check:workflows": "bun scripts/run-workflows-check.ts",
    "check:uncommitted": "bun scripts/run-uncommitted-check.ts",
    "memory-capped": "bash scripts/run-memory-capped.sh \"$(bun scripts/read-memory-budget.ts)\"",
    "check:atc-bridge-drift": "bun run build:atc-bridge && git diff --exit-code packages/harnesses/claude/src/bridge/atc-bridge-files.ts"
  },
  "devDependencies": {
    "@atc/config": "workspace:*",
    "@atc/core": "workspace:*",
    "@atc/daemon": "workspace:*",
    "@atc/execution-imp": "workspace:*",
    "@atc/execution-local": "workspace:*",
    "@atc/gateway": "workspace:*",
    "@atc/harness-claude": "workspace:*",
    "@atc/harness-codex": "workspace:*",
    "@atc/harness-grok": "workspace:*",
    "@atc/lifecycle": "workspace:*",
    "@atc/mcp": "workspace:*",
    "@atc/plugin-api": "workspace:*",
    "@atc/protocol": "workspace:*",
    "@atc/reporters": "workspace:*",
    "@atc/source-dirs": "workspace:*",
    "@atc/source-git": "workspace:*",
    "@atc/source-github": "workspace:*",
    "@atc/store": "workspace:*",
    "@atc/test-utils": "workspace:*",
    "@atcx/contract": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@faker-js/faker": "catalog:",
    "@maschwenk/tsrslint": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/bun-test-extended": "catalog:",
    "@zgeoff/format-codemod": "catalog:",
    "@zgeoff/oxlint-config": "catalog:",
    "@zgeoff/skill-gate": "catalog:",
    "bun-pty": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tiny-invariant": "catalog:",
    "tslib": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "knip@6.41.0": "patches/knip@6.41.0.patch"
  }
}

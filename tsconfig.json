{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@zgeoff/storyboard",
    "types": ["bun", "@zgeoff/bun-test-extended"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/*/src/**/*.ts",
    "e2e/**/*.ts",
    "integration/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "rig.config.ts"
  ]
}

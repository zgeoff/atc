{
  "name": "@atc/execution-local",
  "private": true,
  "description": "The local execution provider: sessions run in PTYs on the daemon's own machine, with stub providers for tests under ./test-utils",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-utils/*": "./src/test-utils/*.ts"
  },
  "dependencies": {
    "@atc/config": "workspace:*",
    "@atc/core": "workspace:*",
    "@atc/plugin-api": "workspace:*",
    "@atc/protocol": "workspace:*",
    "@atcx/contract": "workspace:*",
    "@zgeoff/std": "catalog:",
    "bun-pty": "catalog:"
  },
  "devDependencies": {
    "@zgeoff/testing": "catalog:",
    "tiny-invariant": "catalog:"
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "bin/atc",
        "e2e/**/*.test.ts",
        "integration/**/*.test.ts",
        "scripts/**/*.test.ts",
        "scripts/create-state-template.ts",
        "scripts/pack-contract.ts",
        "scripts/serve-stub-daemon.ts",
        "scripts/write-contract-schemas.ts",
        "scripts/probe-pty-env.ts",
        "rig.config.ts",
        "scripts/run-demo-agent.ts",
        "scripts/run-demo-recording.ts",
        "scripts/test-utils/run-local-daemon.ts",
        "scripts/test-utils/run-docker-daemon.ts"
      ],
      "project": ["e2e/**/*.ts", "integration/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/gateway.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/*/*": {
      "entry": ["src/**/*.test.ts"]
    }
  },
  "ignoreDependencies": ["@stylistic/eslint-plugin"],
  "ignoreBinaries": ["openssl"]
}

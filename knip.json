{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "bin/atc",
        "e2e/**/*.test.ts",
        "scripts/**/*.test.ts",
        "scripts/create-state-template.ts",
        "scripts/probe-pty-env.ts",
        "scripts/stage-demo-sessions.ts",
        "scripts/run-wave-move.ts"
      ],
      "project": ["e2e/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/app": {
      "entry": ["src/gateway.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/daemon": {
      "entry": ["src/**/*.test.ts", "src/testing/run-listener-daemon.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/*/*": {
      "entry": ["src/**/*.test.ts"]
    },
    "packages/test-utils": {
      "entry": ["src/**/*.test.ts", "src/run-stub-*.ts"],
      "ignoreDependencies": ["better-auth"]
    }
  },
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/skill-gate"]
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // the mods follow Claude Code's mod API rather than the repo's style rules,
  // so they take only the package boundaries; .oxlintrc.json ignores them
  "extends": ["./.oxlintrc.zones.json"],
  "categories": { "correctness": "off" },
  // a mod loads a module through an import, and a type through import type
  "rules": {
    "typescript/no-require-imports": "error",
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ]
  }
}
